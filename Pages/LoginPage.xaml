<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="COMP609A2.Pages.LoginPage"
             Title="Login">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Grid BackgroundColor="Transparent" ColumnDefinitions="100,400" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
            
            <Label Grid.Column="0" Grid.Row="0" Text="Username" VerticalTextAlignment="Center"/>
            <Entry Grid.Column="1" Grid.Row="0" x:Name="UsernameEntry" Placeholder="Enter username" BackgroundColor="LightBlue"/>
            <Label Grid.Column="0" Grid.Row="1" Text="Password" VerticalTextAlignment="Center"/>
            <Entry Grid.Column="1" Grid.Row="1" x:Name="PasswordEntry" Placeholder="Enter password" IsPassword="True" BackgroundColor="LightBlue"/>
            <Label Grid.Column="0" Grid.Row="2" Text="Admin" VerticalTextAlignment="Center"/>
            <Picker Grid.Column="1" Grid.Row="2" x:Name="IsAdmin" BackgroundColor="LightBlue">
                <Picker.Items>
                    <x:String>No</x:String>
                    <x:String>Yes</x:String>
                </Picker.Items>
            </Picker>
        </Grid>
        <Grid BackgroundColor="Transparent" ColumnDefinitions="120,120,120" RowDefinitions="Auto" RowSpacing="10">
            <Button  Grid.Column="0" Grid.Row="0" Text="Login" Clicked="Login_Clicked" WidthRequest="100"
HeightRequest="40" HorizontalOptions="Start"/>
            <Button Grid.Column="1" Grid.Row="0" Text="Logout" Clicked="Logout_Clicked" WidthRequest="100"
HeightRequest="40" HorizontalOptions="Start"/>
            <Button Grid.Column="2" Grid.Row="0" Text="Sign In" Clicked="Signin_Clicked" WidthRequest="100"
HeightRequest="40" HorizontalOptions="Start"/>
        </Grid>
        <!--<Button Text="Login" Clicked="Login_Clicked" WidthRequest="100"
HeightRequest="40" HorizontalOptions="Start"/>
        <Button Text="Logout" Clicked="Logout_Clicked" WidthRequest="100"
HeightRequest="40" HorizontalOptions="Start"/>-->
    </VerticalStackLayout>
</ContentPage>